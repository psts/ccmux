.build/
.swiftpm/
*.xcodeproj/
xcuserdata/
DerivedData/
.DS_Store
# GoReleaser build output
dist/
# Local Claude Code state (personal, not for the public repo)
.claude/*
# The gate definitions are the repo's, not one machine's: without them
# qa-receipt.sh finds no test command here (go.mod is under daemon/, and it does
# not recognise Package.swift) and refuses to sign anything.
!.claude/qa-gates
# The gate scripts qa-gates invokes, and their frozen baselines. These must be
# tracked or the gate only works on the machine that wrote it. Un-ignoring the
# DIRECTORY is what does it: git will not descend into an ignored directory, so
# a `!.claude/gates/*` file pattern on its own leaves them all invisible. The
# reverse is not needed — `.claude/*` matches one path segment only, so nothing
# inside re-ignores itself once the directory is back.
!.claude/gates/
SwiftTerm/.build/
SwiftTerm/.swiftpm/
